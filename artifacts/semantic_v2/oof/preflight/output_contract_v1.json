  "csv_record_schema": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
      "binary_prediction": {
        "enum": [
          0,
          1
        ]
      },
      "calibrated_probability": {
        "type": "null"
      },
      "candidate_id": {
        "type": "string"
      },
      "confidence_category": {
        "type": "string"
      },
      "detector_id": {
        "const": "semantic_finetuned"
      },
      "detector_version": {
        "const": "dm_b_v1"
      },
      "error_type": {
        "enum": [
          "TP",
          "TN",
          "FP",
          "FN"
        ]
      },
      "fold": {
        "enum": [
          0,
          1,
          2,
          3,
          4
        ]
      },
      "input_tokens": {
        "type": "integer"
      },
      "label": {
        "enum": [
          0,
          1
        ]
      },
      "latency_ms": {
        "type": "number"
      },
      "lineage_group": {
        "type": "string"
      },
      "logit_margin": {
        "type": "number"
      },
      "max_input_tokens": {
        "const": 256
      },
      "partition": {
        "const": "BASE_TRAIN"
      },
      "payload_position_status": {
        "const": "NOT_AVAILABLE_NOT_INFERRED"
      },
      "raw_score": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
      },
      "sample_id": {
        "type": "string"
      },
      "source_name": {
        "type": "string"
      },
      "source_revision": {
        "type": "string"
      },
      "threshold_distance": {
        "type": "number"
      },
      "tokens_analyzed": {
        "type": "integer"
      },
      "tokens_excluded": {
        "type": "integer"
      },
      "truncated": {
        "type": "boolean"
      }
    },
    "required": [
      "sample_id",
      "partition",
      "fold",
