{
  "calibration_method": "platt_sigmoid_on_lr_log_odds",
  "calibration_version": "dm_a_v1_sigmoid_v1",
  "input": "logit(clip(raw_LR_probability,epsilon,1-epsilon))",
  "epsilon": 1e-12,
  "target_smoothing": "positive=(Npos+1)/(Npos+2); negative=1/(Nneg+2)",
  "optimizer": "L-BFGS-B",
  "initial_slope": 1.0,
  "positive_slope_lower_bound": 1e-08,
  "initial_intercept": "log((Npos+1)/(Nneg+1))",
  "random_state": "none; deterministic",
  "maxiter": 1000,
  "ftol": 1e-12,
  "gtol": 1e-10,
  "class_weight": null,
  "penalty": null,
  "threshold_optimized": false,
  "binary_vote_basis": "raw_score >= 0.5; DEFAULT_DEVELOPMENT_CUTPOINT"
}
