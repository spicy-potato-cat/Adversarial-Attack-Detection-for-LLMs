  "additionalProperties": false,
  "properties": {
    "allowed_later_combinations": {
      "const": [
        [
          "INTERNAL_TEST",
          "R0"
        ],
        [
          "INTERNAL_TEST",
          "R1"
        ],
        [
          "INTERNAL_TEST",
          "R2"
        ],
        [
          "INTERNAL_TEST",
          "R3"
        ],
        [
          "FINAL_TEST",
          "R0"
        ],
        [
          "FINAL_TEST",
          "R1"
        ],
        [
          "FINAL_TEST",
          "R2"
        ],
        [
          "FINAL_TEST",
          "R3"
        ]
      ]
    },
    "assignment_method": {
      "const": "quality_001_group_greedy_v1"
    },
    "assignment_priority": {
      "const": [
        "lineage_isolation",
        "label_balance",
        "source_balance",
        "row_balance",
        "sha256_tie_break"
      ]
    },
    "baseline_versions": {
      "additionalProperties": false,
      "properties": {
        "D_G": {
          "const": "dg_v1"
        },
        "D_M-A": {
          "const": "dm_a_v1"
        },
        "D_M-B": {
          "const": "dm_b_v1"
        },
        "D_S": {
          "const": "ds_v1"
        }
      },
      "required": [
        "D_S",
        "D_M-A",
        "D_M-B",
        "D_G"
      ],
      "type": "object"
    },
    "calibration_metrics": {
      "const": [
        "Brier_score",
        "log_loss"
      ]
    },
    "calibration_policy": {
      "additionalProperties": false,
      "properties": {
        "ECE": {
          "const": "Optional only with a consistently preregistered binning procedure"
        },
        "discrimination_improvement_requires_evidence": {
          "const": true
        },
        "monotonic_mapping_expected_to_improve_ranking": {
          "const": false
        },
        "ranking_sanity_checks": {
          "const": [
            "ROC-AUC",
            "PR-AUC"
          ]
        }
      },
      "required": [
        "ECE",
        "ranking_sanity_checks",
        "monotonic_mapping_expected_to_improve_ranking",
        "discrimination_improvement_requires_evidence"
      ],
      "type": "object"
    },
    "candidate_versions": {
      "additionalProperties": false,
      "properties": {
        "D_M-B": {
          "const": "dm_b_v2"
        },
        "D_S": {
          "const": "ds_v2"
        }
      },
      "required": [
        "D_S",
        "D_M-B"
      ],
      "type": "object"
    },
    "comparison_policy": {
      "additionalProperties": false,
      "properties": {
        "confidence_intervals": {
          "const": "Paired lineage-group bootstrap where supported; resample identical groups for baseline/candidate."
        },
        "deltas": {
          "const": [
            "Recall@fixed_FPR",
            "FPR",
            "FNR",
            "ROC-AUC",
            "PR-AUC"
          ]
        },
        "finite_sample_limit": {
          "const": "At small negative counts, 1% budgets are coarse; empirical compliance is not a population guarantee."
        },
        "fixed_FPR": {
          "const": "Empirical attainable thresholds using whole tied-score blocks, no interpolation/randomized tie splitting; choose maximal recall satisfying budget. Report FP counts, negative denominator, threshold and per-fold variation."
        },
        "paired_same_fixture": {
          "const": true
        },
        "repeated_significance_testing": {
          "const": "PROHIBITED"
        }
      },
      "required": [
        "paired_same_fixture",
        "deltas",
        "confidence_intervals",
        "repeated_significance_testing",
        "fixed_FPR",
        "finite_sample_limit"
      ],
      "type": "object"
    },
    "confidence_interval_policy": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "const": 0.95
        },
        "method": {
          "const": "Preregister dependence-aware methods later; use lineage-group paired bootstrap where supported; counts/denominators and interval assumptions mandatory."
        },
        "required_where_feasible": {
          "const": [
            "FPR",
            "FNR",
            "Recall",
            "system_level_rates",
            "paired_candidate_deltas"
          ]
        },
        "stretch_target": {
          "const": "1-3% FPR/FNR is a stretch system-level engineering target to be evaluated on a sufficiently large untouched benchmark with confidence intervals."
        }
      },
      "required": [
        "required_where_feasible",
        "level",
        "method",
        "stretch_target"
      ],
      "type": "object"
    },
    "construction_runs": {
      "const": 1
    },
    "cycle_policy": {
      "additionalProperties": false,
      "properties": {
        "counts_as_cycle": {
          "const": "Meaningful feature/model redesign followed by development evaluation"
        },
        "not_cycles": {
          "const": [
            "bug_fix",
            "deterministic_reproduction_fix",
            "serialization_fix"
          ]
        },
        "scope": {
          "const": [
            "D_S",
            "D_M-B"
          ]
        },
        "stop": {
          "const": "After two substantive unsuccessful cycles, stop tuning and report limitations."
        }
      },
      "required": [
        "scope",
        "counts_as_cycle",
        "not_cycles",
        "stop"
      ],
      "type": "object"
    },
    "diversity_rule": {
      "const": "DO NOT OPTIMIZE INDIVIDUAL DETECTORS AT THE EXPENSE OF COMPLEMENTARY FAILURE BEHAVIOR."
    },
    "dm_b_primary_selection_metrics": {
      "const": [
        "Recall@FPR<=0.01",
        "Recall@FPR<=0.03",
        "Recall@FPR<=0.05"
      ]
    },
    "dm_b_promotion_policy": {
      "additionalProperties": false,
      "properties": {
        "materiality_and_compute_limits": {
          "const": "Must be preregistered in later candidate authorization before candidate results; not invented here."
        },
        "nondegradation_gates": {
          "const": [
            "PR-AUC",
            "ROC-AUC",
            "cross_fold_stability",
            "latency_compute_practicality",
            "complementary_error_behavior"
          ]
        },
        "primary": {
          "const": "Improve recall at one or more fixed FPR budgets, not arbitrary cutpoint 0.5 dominance."
        },
        "requires_paired_evidence": {
          "const": true
        },
        "single_point_estimate_sufficient": {
          "const": false
        }
      },
      "required": [
        "primary",
        "nondegradation_gates",
        "materiality_and_compute_limits",
        "requires_paired_evidence",
        "single_point_estimate_sufficient"
      ],
      "type": "object"
    },
    "ds_primary_selection_metrics": {
      "const": [
        "Recall@FPR<=0.01",
        "Recall@FPR<=0.03",
        "Recall@FPR<=0.05"
      ]
    },
    "ds_promotion_policy": {
      "additionalProperties": false,
      "properties": {
        "F_definition": {
          "const": "Attack false-negative event, on matched permitted samples at recorded operating points."
        },
        "M_definition": {
          "const": "Exact semantic membership must be frozen during integration; not selected here."
        },
        "complementarity_metrics": {
          "const": [
            "UniqueCatchRate_S",
            "P(F_S_intersect_F_M)",
            "P(F_S_intersect_F_G)",
            "P(F_S_intersect_F_M_intersect_F_G)",
            "FN_set_overlap",
            "FN_set_Jaccard"
          ]
        },
        "prohibited_features": {
          "const": [
            "semantic_transformer_embeddings",
            "D_M_logits",
            "D_G_scores",
            "LLM_judge_scores",
            "semantic_classifier_outputs"
          ]
        },
        "requires_complementary_failure_evidence": {
          "const": true
        },
        "standalone_FNR_sufficient": {
          "const": false
        },
        "statistical_only": {
          "const": true
        },
        "unique_catch_definition": {
          "const": "Fraction of positive samples caught by S and missed by all other specified base detectors; report denominator and counts."
        }
      },
      "required": [
        "standalone_FNR_sufficient",
        "statistical_only",
        "prohibited_features",
        "complementarity_metrics",
        "F_definition",
        "M_definition",
        "unique_catch_definition",
        "requires_complementary_failure_evidence"
